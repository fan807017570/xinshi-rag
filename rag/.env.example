# 复制为 .env 并填入真实值

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_MODEL_LITTLE=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS_LITTLE=128
DEEPSEEK_TEMPERATURE_LITTLE=0.2
DEEPSEEK_TEMPERATURE=0.0
# 本地意图分类器：模型与 svc.joblib 随 RAG 服务部署，不访问外部模型仓库。
SCORE_INTENT_MODEL_DIR=./rag/models/bge-base-zh-v1.5
SCORE_INTENT_CLASSIFIER_PATH=./rag/models/intent/svc.joblib
SCORE_INTENT_MODEL_VERSION=local-bge-base-zh-v1.5-svc-v1
# SVM 预测 query_score 时：>= 高阈值直接查询；落在 [灰区阈值, 高阈值) 调用 LLM 二次识别。
SCORE_INTENT_THRESHOLD=0.98
SCORE_INTENT_AMBIGUOUS_THRESHOLD=0.90
# LLM 二次识别结果的置信度阈值。
SCORE_INTENT_LLM_THRESHOLD=0.85
SCORE_INTENT_LLM_AMBIGUOUS_THRESHOLD=0.60
SCORE_INTENT_LLM_TIMEOUT_MS=1500
SCORE_SLOT_LLM_TIMEOUT_MS=1500
# 可选：默认回退 DEEPSEEK_MODEL_INTENT / DEEPSEEK_MODEL
# DEEPSEEK_MODEL_SCORE_SLOT=deepseek-v4-flash
# 兼容旧部署：WECHAT_SCORE_INTENT_* 同名变量可作为回退配置

# 微信服务器校验 Token（需与微信公众平台配置一致）
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_APPID=
WECHAT_APPSECRET=
# 可选：若已有外部 access_token 管理服务，可直接注入；否则服务会用 AppID/AppSecret 自动获取并缓存
WECHAT_ACCESS_TOKEN=
WECHAT_CALLBACK_ENABLED=false
WECHAT_CUSTOM_REPLY_WORKERS=2
WECHAT_CUSTOM_REPLY_TIMEOUT=10
WECHAT_CUSTOM_REPLY_MAX_BYTES=1800
# 成绩查询能力同时用于微信 /api/chat 与 Web /api/chat/completions
SCORE_QUERY_ENABLED=false
SCORE_H5_URL=http://score.example.edu/h5/score?appid=wx1234567890abcdef
# 兼容旧部署变量；仅在未配置上述新变量时生效
# WECHAT_SCORE_QUERY_ENABLED=false
# WECHAT_SCORE_H5_URL=http://score.example.edu/h5/score?appid=wx1234567890abcdef
WECHAT_SCORE_CONTEXT_API_URL=http://xinshi-admin-backend:8080/api/internal/wechat/score-query-contexts
WECHAT_SCORE_CONTEXT_SERVICE_ID=xinshi-rag
WECHAT_SCORE_CONTEXT_SIGNING_SECRET=
WECHAT_SCORE_CONTEXT_TIMEOUT_SECONDS=3

# RAG 应用端口
RAG_PORT=18765            # RAG 服务对外端口

# config.py 的运行参数已移至 config/application.ini。
# Docker 会自动使用其中的 docker profile，原生部署默认使用 native。
XINSHI_NETWORK=xinshi-net

# Docker 宿主机目录挂载（相对路径基于 rag/docker-install/docker-compose.yml）
XINSHI_CONFIG_DIR=../../config
XINSHI_BASE_DATA_DIR=../data/base
XINSHI_DOCS_DATA_DIR=../data/docs
XINSHI_EMBEDDING_MODEL_DIR=../models/bge-base-zh-v1.5
XINSHI_RERANK_MODEL_DIR=../models/bge-reranker-large
