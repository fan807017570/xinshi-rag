# 复制为 .env 并填入真实值

# DeepSeek API Key（必填）
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS=1024
DEEPSEEK_MODEL_LITTLE=deepseek-v4-flash
DEEPSEEK_MAX_TOKENS_LITTLE=128
DEEPSEEK_TEMPERATURE_LITTLE=0.2
DEEPSEEK_TEMPERATURE=0.0

# 微信服务器校验 Token（需与微信公众平台配置一致）
WECHAT_TOKEN=
WECHAT_ENCODING_AES_KEY=
WECHAT_APPID=
WECHAT_APPSECRET=
# 可选：若已有外部 access_token 管理服务，可直接注入；否则服务会用 AppID/AppSecret 自动获取并缓存
WECHAT_ACCESS_TOKEN=
WECHAT_CUSTOM_REPLY_WORKERS=2
WECHAT_CUSTOM_REPLY_TIMEOUT=10
WECHAT_CUSTOM_REPLY_MAX_BYTES=1800

# RAG 应用端口
RAG_PORT=18765            # RAG 服务对外端口

# config.py 的运行参数已移至 config/application.ini。
# Docker 会自动使用其中的 docker profile，原生部署默认使用 native。
XINSHI_NETWORK=xinshi-net

# Docker 宿主机目录挂载（相对路径基于 rag/docker-install/docker-compose.yml）
XINSHI_CONFIG_DIR=../../config
XINSHI_BASE_DATA_DIR=../data/base
XINSHI_DOCS_DATA_DIR=../data/docs
XINSHI_EMBEDDING_MODEL_DIR=../models/bge-base-zh-v1.5
XINSHI_RERANK_MODEL_DIR=../models/bge-reranker-large
