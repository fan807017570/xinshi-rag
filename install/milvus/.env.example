# Milvus 对宿主机暴露的端口；macOS / Ubuntu 原生 RAG 应用连接此端口。
MILVUS_EXPOSED_PORT=19531

# MinIO API 和控制台端口。
MINIO_API_PORT=19000
MINIO_UI_PORT=19001

# 与 RAG 应用共用的 Docker 网络。
XINSHI_NETWORK=xinshi-net

# 沿用旧的一体化 Compose 默认项目名，便于复用已有容器和数据卷。
COMPOSE_PROJECT_NAME=xinshi

# 固定卷名，避免 Compose 所在目录变化导致数据卷变化。
ETCD_VOLUME_NAME=xinshi_etcd_data
MINIO_VOLUME_NAME=xinshi_minio_data
MILVUS_VOLUME_NAME=xinshi_milvus_data
